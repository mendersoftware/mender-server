// renovate.json5 - Mender dependency update configuration for mender-server
// See Documentation/dependency-updates.md in mender-qa for the process.
{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",

  "extends": [
    "config:recommended"
  ],

  "ignorePaths": ["**/node_modules/**", "**/vendor/**"],

  // CODEOWNERS drives reviewer assignment. Keep CODEOWNERS complete.
  "reviewersFromCodeOwners": true,

  // chore(deps): <desc>, matching the old Dependabot prefix.
  "semanticCommits": "enabled",
  "semanticCommitScope": "deps",

  // Append a table in the commit message body describing all updates in the commit.
  "commitBodyTable": true,
  // Replaces the ":gitSignOff" preset: preset trailers are prepended to ours,
  // but commitlint requires the sign-off to be the last trailer.
  "commitTrailers": ["Changelog: Commit", "Signed-off-by: {{{gitAuthor}}}"],

  // Only rebase open PRs when they actually conflict. Rebasing every time the
  // base branch moves restarts a pipeline for every open PR on each merge.
  "rebaseWhen": "conflicted",

  // Drain backlogs fully. We don't want to miss a thing!
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,

  "baseBranchPatterns": ["main", "4.1.x"],

  // Security PRs bypass the schedule and automerge when CI is green.
  "vulnerabilityAlerts": {
    "enabled": true,
    "schedule": ["at any time"],
    "automerge": false,
    "automergeType": "pr",
    "labels": ["security"]
  },

  "docker-compose": {
    "registryAliases": {
      "${MIRROR_REGISTRY:-docker.io}": "docker.io"
    }
  },

  // Mender-internal versions not visible to standard managers.
  "customManagers": [
    // MENDER_ARTIFACT_VERSION as a Dockerfile ARG (create-artifact-worker, tests).
    {
      "customType": "regex",
      "managerFilePatterns": ["/Dockerfile/"],
      "matchStrings": [
        "MENDER_ARTIFACT_VERSION=\\s*[\"']?(?<currentValue>[\\d\\.]+)[\"']?"
      ],
      "depNameTemplate": "mendersoftware/mender-artifact",
      "packageNameTemplate": "mender-artifact",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v?(?<version>.*)$",
      "versioningTemplate": "semver"
    },
    // DOCKER_VERSION as a .gitlab-ci.yml variable (currently tracked by nothing).
    {
      "customType": "regex",
      "managerFilePatterns": ["/.gitlab-ci.yml/"],
      "matchStrings": [
        "DOCKER_VERSION:[\\s\\S]*?value:\\s*[\"']?(?<currentValue>[\\d\\.]+)[\"']?"
      ],
      "depNameTemplate": "docker",
      "packageNameTemplate": "docker",
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    // MONGO_VERSION, pinned both as a .gitlab-ci.yml variable and as the
    // ${MONGO_VERSION:-8.0} compose default. The variable tag defeats the
    // docker-compose manager, so both sites need a regex manager to move together.
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)\\.gitlab-ci\\.yml$/",
        "/(^|/)docker-compose\\.yml$/"
      ],
      "matchStrings": [
        "MONGO_VERSION:[\\s\\S]*?value:\\s*[\"']?(?<currentValue>[\\d\\.]+)[\"']?",
        "library/mongo:\\$\\{MONGO_VERSION:-(?<currentValue>[\\d\\.]+)\\}"
      ],
      "depNameTemplate": "mongo",
      "packageNameTemplate": "mongo",
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)\\.gitlab-ci\\.yml$/"],
      "matchStrings": [
        "MENDER_HELM_CHART_VERSION:[\\s\\S]*?value:\\s*[\"']?(?<currentValue>[\\d\\.]+)[\"']?"
      ],
      "depNameTemplate": "mender",
      "registryUrlTemplate": "https://charts.mender.io",
      "datasourceTemplate": "helm"
    },
    // REDIS_VERSION as a .gitlab-ci.yml variable (currently tracked by nothing).
    {
      "customType": "regex",
      "managerFilePatterns": ["/.gitlab-ci.yml/"],
      "matchStrings": [
        "REDIS_VERSION:[\\s\\S]*?value:\\s*[\"']?(?<currentValue>[\\d\\.]+)[\"']?"
      ],
      "depNameTemplate": "redis",
      "packageNameTemplate": "redis",
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    // frontend/pipeline.yml is a `local:` include, so the gitlabci manager does
    // not scan it. These two regex managers track its pinned images directly -
    // a custom manager is required because the ${MIRROR_REGISTRY} prefix and the
    // NODE_IMAGE variable defeat the stock gitlabci manager.
    //
    // denoland/deno image, pinned as a literal tag.
    {
      "customType": "regex",
      "managerFilePatterns": ["/frontend/pipeline.yml/"],
      "matchStrings": [
        "denoland/deno:(?<currentValue>[^\\s\"']+)"
      ],
      "depNameTemplate": "denoland/deno",
      "packageNameTemplate": "deno",
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    // NODE_IMAGE CI variable (value like node:24-alpine).
    {
      "customType": "regex",
      "managerFilePatterns": ["/frontend/pipeline.yml/"],
      "matchStrings": [
        "NODE_IMAGE:[\\s\\S]*?value:\\s*[\"']?(?<depName>[^:\"']+):(?<currentValue>[^\"']+)[\"']?"
      ],
      "packageNameTemplate": "node",
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ],

  "packageRules": [
    // GitLab CI image bumps
    {
      "matchManagers": ["gitlabci", "gitlabci-include"],
      "semanticCommitScope": ""
    },

    // Go: one fix PR for backend modules and one chore PR for other modules.
    {
      "matchManagers": ["gomod"],
      "groupName": "Go modules (development)",
      "groupSlug": "golang-dependencies-dev",
      "postUpdateOptions": ["gomodTidyAll"]
    },
    {
      "matchManagers": ["gomod"],
      "matchFileNames": ["backend/go.mod"],
      "semanticCommitType": "fix",
      "groupName": "Go modules",
      "groupSlug": "golang-dependencies",
      "postUpdateOptions": ["gomodTidyAll"]
    },

    // Docker base images: one PR for development images and one for product iamges.
    // The native dockerfile manager resolves the `ARG REGISTRY` form Dependabot ignored.
    {
      "matchManagers": ["dockerfile"],
      "groupName": "Docker base images (development)",
      "groupSlug": "docker-base-images-dev"
    },
    {
      "matchManagers": ["dockerfile"],
      "matchFileNames": ["backend/services/*/Dockerfile", "frontend/Dockerfile"],
      "semanticCommitType": "fix",
      "groupName": "Docker base images",
      "groupSlug": "docker-base-images"
    },

    // docker-compose: root + compose/*.yml + nested compose files in one PR.
    {
      "matchManagers": ["docker-compose"],
      "matchFileNames": ["**/docker-compose+(.*.|.)+(yml|yaml)", "!**/docker-compose.*compat*.yml"],
      "groupName": "docker-compose",
      "groupSlug": "docker-compose"
    },

    // Python: one PR for all pip deps.
    {
      "matchManagers": ["pip_requirements", "pipenv", "poetry"],
      "groupName": "python-dependencies",
      "groupSlug": "python-dependencies"
    },

    {
      "matchManagers": ["npm"],
      "matchDepTypes": ["dependencies"],
      "matchFileNames": ["frontend/package.json"],
      "semanticCommitType": "fix"
    },
    // npm: five groups, matching the old Dependabot policy.
    {
      "matchManagers": ["npm"],
      "matchDepTypes": ["devDependencies"],
      "groupName": "npm-dev-dependencies"
    },
    {
      "matchManagers": ["npm"],
      "matchDepTypes": ["dependencies"],
      "matchPackageNames": ["!/^@emotion/", "!/^@mui/"],
      "groupName": "npm-prod-dependencies"
    },
    {
      "matchPackageNames": ["/^@emotion/", "/^@mui/"],
      "groupName": "npm-mui"
    },
    {
      "matchFileNames": ["frontend/tests/e2e_tests/package.json"],
      "matchPackageNames": ["/^@playwright/", "/^playwright/"],
      "groupName": "playwright"
    },
    {
      "matchFileNames": ["frontend/tests/e2e_tests/package.json"],
      "matchPackageNames": ["!/^@playwright/", "!/^playwright/"],
      "groupName": "test-dependencies"
    },
    // Drop this rule once the frontend toolchain supports ts 7.
    {
      "matchPackageNames": ["typescript"],
      "allowedVersions": "!/^7\\.0\\./"
    },

    // Submodules are managed by release tooling.
    {
      "matchManagers": ["git-submodules"],
      "enabled": false
    },

    // No major bumps on maintenance branches - those need an explicit backport call.
    {
      "matchBaseBranches": ["/^\\d+\\.\\d+\\.x$/"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    // Internal @northern.tech packages should not be backported on maintenance branches.
    {
      "matchBaseBranches": ["/^\\d+\\.\\d+\\.x$/"],
      "matchPackageNames": ["@northern.tech/**"],
      "enabled": false
    }
  ]
}
