              style="clip-path: inset(50%); overflow: hidden; white-space: nowrap; border: 0px; padding: 0px; width: 1px; height: 1px; margin: -1px; position: fixed; top: 0px; left: 0px;"
              tabindex="-1"
              type="number"
              value="1"
            />
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
`;
