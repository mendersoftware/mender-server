                  class="MuiOutlinedInput-notchedOutline emotion-11"
                >
                  <legend
                    class="emotion-12"
                  >
                    <span
                      aria-hidden="true"
                      class="notranslate"
                    >
                      ​
                    </span>
                  </legend>
                </fieldset>
              </div>
            </div>
          </div>
          <p
            class="emotion-13 "
          >
            Note: individual devices can't be added to dynamic groups.
            <br />
            <a
              class="MuiTypography-root MuiTypography-inherit MuiLink-root MuiLink-underlineAlways emotion-14"
              href="https://docs.mender.io/overview/device-group"
              rel="noopener"
              target="_blank"
            >
              Learn more about static vs. dynamic groups
            </a>
          </p>
        </div>
        <div
          class="MuiDialogActions-root MuiDialogActions-spacing emotion-15"
        >
          <button
            class="MuiButtonBase-root MuiButton-root MuiButton-text MuiButton-sizeMedium MuiButton-colorPrimary margin-right-x-small emotion-16"
            tabindex="0"
            type="button"
          >
            Cancel
          </button>
          <button
            class="MuiButtonBase-root MuiButton-root MuiButton-contained MuiButton-sizeMedium MuiButton-colorPrimary emotion-17"
            tabindex="0"
            type="submit"
          >
            Create group
          </button>
        </div>
      </form>
    </div>
  </div>
  <div
    data-testid="sentinelEnd"
    tabindex="0"
  />
</div>
`;
